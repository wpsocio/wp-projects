{
	"name": "@wpsocio/vite-wp-react",
	"version": "2.0.0",
	"description": "Set of tools to develop WordPress plugins and themes using React and Vite.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/wpsocio/wp-projects",
		"directory": "tools/vite-wp-react"
	},
	"homepage": "https://github.com/wpsocio/wp-projects/tree/main/tools/vite-wp-react",
	"author": {
		"name": "WP Socio",
		"url": "https://wpsocio.com"
	},
	"bugs": {
		"url": "https://github.com/wpsocio/wp-projects/issues"
	},
	"files": [
		"dist",
		"src"
	],
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		},
		"./config": {
			"require": {
				"types": "./dist/config.d.cts",
				"default": "./dist/config.cjs"
			},
			"import": {
				"types": "./dist/config.d.mts",
				"default": "./dist/config.mjs"
			}
		}
	},
	"typesVersions": {
		"*": {
			"config": [
				"./dist/config.d.cts"
			]
		}
	},
	"dependencies": {
		"@vitejs/plugin-react": "^5.2.0",
		"@wordpress/babel-plugin-makepot": "^6.52.0",
		"rolldown": "^1.2.1"
	},
	"devDependencies": {
		"@types/node": "^25.0.3",
		"rimraf": "^6.1.2",
		"tsdown": "^0.22.14",
		"typescript": "^6.0.3",
		"vite": "^8.2.0",
		"wireit": "^0.14.12"
	},
	"peerDependencies": {
		"vite": "^8"
	},
	"scripts": {
		"build": "wireit",
		"build:local": "wireit",
		"clean": "rimraf dist/ tsconfig.tsbuildinfo .wireit",
		"prepublishOnly": "wireit",
		"typecheck": "tsc --noEmit",
		"watch": "tsc --watch"
	},
	"wireit": {
		"build": {
			"command": "tsdown",
			"clean": "if-file-deleted",
			"files": [
				"src/",
				"tsconfig.json",
				"tsdown.config.ts"
			],
			"output": [
				"dist/**"
			]
		},
		"build:local": {
			"dependencies": [
				"build"
			]
		},
		"prepublishOnly": {
			"command": "pnpm run build",
			"dependencies": [
				"clean"
			]
		}
	}
}
